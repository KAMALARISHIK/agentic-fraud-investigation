USE GRAPH FraudGraph

CREATE OR REPLACE QUERY device_neighbors(VERTEX<DeviceProfile> target_device, DATETIME start_ts, DATETIME end_ts) FOR GRAPH FraudGraph {
    /* Finds other cards and customers that used this device profile */
    SetAccum<VERTEX<Card>> @@connected_cards;
    SetAccum<VERTEX<Customer>> @@connected_customers;
    ListAccum<VERTEX<Transaction>> @@related_txns;

    Start = { target_device };
    Txns = SELECT t FROM Start:d <-(FROM_DEVICE:e)- Transaction:t
           WHERE t.ts >= start_ts AND t.ts <= end_ts
           ACCUM @@related_txns += t;

    Cards = SELECT c FROM Txns:t <-(MADE:e)- Card:c
            ACCUM @@connected_cards += c;

    Custs = SELECT cust FROM Cards:c <-(OWNS:e)- Customer:cust
            ACCUM @@connected_customers += cust;

    PRINT @@connected_cards AS connected_cards,
          @@connected_customers AS connected_customers,
          @@related_txns.size() AS shared_transaction_count;
}
