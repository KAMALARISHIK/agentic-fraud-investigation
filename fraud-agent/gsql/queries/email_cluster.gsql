USE GRAPH FraudGraph

CREATE OR REPLACE QUERY email_cluster(VERTEX<EmailDomain> target_domain, DATETIME start_ts, DATETIME end_ts) FOR GRAPH FraudGraph {
    /* Finds other cards using this email domain */
    SetAccum<VERTEX<Card>> @@cards_in_cluster;
    SumAccum<INT> @@txn_count;

    Start = { target_domain };
    Txns = SELECT t FROM Start:em <-(PURCHASER_EMAIL:e|RECIPIENT_EMAIL:e)- Transaction:t
           WHERE t.ts >= start_ts AND t.ts <= end_ts
           ACCUM @@txn_count += 1;

    Cards = SELECT c FROM Txns:t <-(MADE:e)- Card:c
            ACCUM @@cards_in_cluster += c;

    PRINT @@cards_in_cluster AS connected_cards,
          @@cards_in_cluster.size() AS unique_card_count,
          @@txn_count AS transaction_count;
}
