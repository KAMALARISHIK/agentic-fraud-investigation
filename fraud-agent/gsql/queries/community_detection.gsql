USE GRAPH FraudGraph

CREATE OR REPLACE QUERY community_detection(INT max_iter) FOR GRAPH FraudGraph {
    /* Weakly Connected Components across Card <-> DeviceProfile shared graph */
    MapAccum<STRING, SetAccum<STRING>> @@device_rings;

    Devs = { DeviceProfile.* };
    Txns = SELECT t FROM Devs:d -(<FROM_DEVICE:e)- Transaction:t;
    Cards = SELECT c FROM Txns:t -(<MADE:e)- Card:c
            ACCUM @@device_rings += (c.card_id -> c.card_id);

    PRINT @@device_rings.size() AS active_clusters;
}
