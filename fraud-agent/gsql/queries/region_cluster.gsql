USE GRAPH FraudGraph

CREATE OR REPLACE QUERY region_cluster(VERTEX<BillingRegion> target_region, DATETIME start_ts, DATETIME end_ts) FOR GRAPH FraudGraph {
    /* Finds distinct cards active in a billing region within a time window */
    SetAccum<VERTEX<Card>> @@cards_in_region;
    SumAccum<INT> @@txn_count;
    SumAccum<DOUBLE> @@total_amount;

    Start = { target_region };
    Txns = SELECT t FROM Start:r -(<BILLED_IN:e)- Transaction:t
           WHERE t.ts >= start_ts AND t.ts <= end_ts
           ACCUM 
               @@txn_count += 1,
               @@total_amount += t.amount;

    Cards = SELECT c FROM Txns:t -(<MADE:e)- Card:c
            ACCUM @@cards_in_region += c;

    PRINT @@cards_in_region AS cards_in_region,
          @@cards_in_region.size() AS unique_card_count,
          @@txn_count AS transaction_count,
          @@total_amount AS total_volume_usd;
}
